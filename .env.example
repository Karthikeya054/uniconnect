DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/uniconnect"
REDIS_URL="redis://localhost:6379"
ADMIN_EMAIL="user@example.com"
PUBLIC_BASE_URL="http://localhost:5173"
COOKIE_NAME="uniconnect_session"
COOKIE_SECURE="false"
SESSION_TTL_HOURS="168"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_LOGIN_REDIRECT_URI="http://localhost:5173/api/auth/google/callback"
GOOGLE_GMAIL_REDIRECT_URI="http://localhost:5173/api/mailboxes/google/callback"
GOOGLE_MEETING_REDIRECT_URI="http://localhost:5173/api/meetings/google/callback"
GOOGLE_SHEETS_REDIRECT_URI="http://localhost:5173/api/sheets/google/callback"
ENCRYPTION_KEY_BASE64="YOUR_32_BYTE_BASE64_KEY"
GEMINI_API_KEY=""

# Fee Collection auto-sync — shared secret between worker and app.
# Worker uses this to call the app's sync endpoint without a user session.
# Set the SAME value in both app and worker environments (Railway, local, etc).
INTERNAL_SYNC_TOKEN=""
# App URL the worker hits for sync (defaults to https://uniconnect-app.up.railway.app in prod)
APP_BASE_URL="http://localhost:5173"
