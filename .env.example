# ─────────────────────────────────────────────────────────────────────
# UniConnect — environment template
# Copy to .env and fill in. Never commit a real .env.
# ─────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/uniconnect"
REDIS_URL="redis://localhost:6379"
NODE_ENV="development"

# ── URLs ─────────────────────────────────────────────────────────────
PUBLIC_BASE_URL="http://localhost:5173"
PUBLIC_APP_URL="http://localhost:5173"
APP_BASE_URL="http://localhost:5173"
APP_URL="http://localhost:5173"
ORIGIN="http://localhost:5173"

# ── Session / crypto ─────────────────────────────────────────────────
COOKIE_NAME="uniconnect_session"
COOKIE_SECURE="false"
SESSION_TTL_HOURS="168"
# 32 random bytes, base64. Generate: openssl rand -base64 32
ENCRYPTION_KEY_BASE64="YOUR_32_BYTE_BASE64_KEY"
JWT_SECRET="YOUR_JWT_SECRET"
# Guards the one-time setup endpoint.
SETUP_SECRET="YOUR_SETUP_SECRET"

# ── Google OAuth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_LOGIN_REDIRECT_URI="http://localhost:5173/api/auth/google/callback"
GOOGLE_GMAIL_REDIRECT_URI="http://localhost:5173/api/mailboxes/google/callback"
GOOGLE_MEETING_REDIRECT_URI="http://localhost:5173/api/meetings/google/callback"
GOOGLE_SHEETS_REDIRECT_URI="http://localhost:5173/api/sheets/google/callback"
GOOGLE_DRIVE_REDIRECT_URI="http://localhost:5173/api/assessments/drive/callback"
# Service-account JSON, as a single-line string. Used for server-side Google APIs.
GOOGLE_CREDENTIALS_JSON=""

# ── SMTP (outbound mail) ─────────────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="YOUR_SMTP_USER"
SMTP_PASS="YOUR_SMTP_PASSWORD"
SMTP_FROM="UniConnect <no-reply@example.com>"

# ── Gemini (daily report generation) ─────────────────────────────────
GEMINI_API_KEY=""

# ── People / routing (comma-separated email lists) ───────────────────
# Bootstrap admin: this address becomes ADMIN on first Google sign-in.
ADMIN_EMAIL="admin@example.com"
# Always copied on access-request alerts.
ADMIN_EMAILS="admin@example.com"
# May override university scoping on a communication task.
TASK_OVERRIDE_EMAILS="admin@example.com"
# Copied on every budget-proposal mail.
BUDGET_STAKEHOLDER_EMAILS="approver1@example.com"
# Added only once a proposal crosses the admin-approval threshold.
BUDGET_ADMIN_APPROVER_EMAILS="admin@example.com"
# Petty cash two-level approval chain.
PETTY_CASH_L1_EMAILS="approver1@example.com"
PETTY_CASH_L2_EMAILS="approver2@example.com"
PETTY_CASH_DISBURSER_EMAIL="disburser@example.com"
PETTY_CASH_DISBURSER_NAME="Disburser"
# Always copied on the fee-collection snapshot mail.
FEE_SNAPSHOT_RECIPIENTS="admin@example.com"

# ── Worker ↔ app shared secret ───────────────────────────────────────
# The worker calls the app's sync endpoints without a user session.
# Set the SAME value in both environments.
INTERNAL_SYNC_TOKEN=""

# ── Firebase push notifications (optional) ───────────────────────────
# Public by design — these ship to the browser. Leave blank to disable push.
# The service worker (apps/app/static/firebase-messaging-sw.js) cannot read
# env vars: edit its placeholders by hand to match these values.
PUBLIC_FIREBASE_API_KEY=""
PUBLIC_FIREBASE_AUTH_DOMAIN=""
PUBLIC_FIREBASE_PROJECT_ID=""
PUBLIC_FIREBASE_STORAGE_BUCKET=""
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
PUBLIC_FIREBASE_APP_ID=""
PUBLIC_FIREBASE_MEASUREMENT_ID=""
PUBLIC_FIREBASE_VAPID_KEY=""
# Server-side Firebase Admin credentials, as a single-line JSON string.
FIREBASE_SERVICE_ACCOUNT=""

# ── Optional integrations ────────────────────────────────────────────
# PDF/layout extraction microservice.
EXTRACTOR_BASE_URL=""
# Outbound webhook to the facilities system.
FACILITIES_OS_WEBHOOK_URL=""
FACILITIES_WEBHOOK_SECRET=""
# API key for the read-only external ops API.
OPS_EXTERNAL_API_KEY=""
